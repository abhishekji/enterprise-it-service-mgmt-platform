# Copy to .env for docker compose overrides. Services fall back to these defaults for local dev.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

MONGO_URI_AUTH=mongodb://localhost:27022/itsm_auth
MONGO_URI_INCIDENT=mongodb://localhost:27018/itsm_incident
MONGO_URI_REQUEST=mongodb://localhost:27019/itsm_request
MONGO_URI_ASSET=mongodb://localhost:27020/itsm_asset
MONGO_URI_WORKFLOW=mongodb://localhost:27021/itsm_workflow

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
